<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_order" resource="sales">
        <column xsi:type="varchar" name="customer_lastnamekana" nullable="true" length="255"
                comment="Customer Lastname Kana"/>
        <column xsi:type="varchar" name="customer_firstnamekana" nullable="true" length="255"
                comment="Customer Firstname Kana"/>
    </table>
    <table name="quote" resource="checkout">
        <column xsi:type="varchar" name="customer_lastnamekana" nullable="true" length="255"
                comment="Customer Lastname Kana"/>
        <column xsi:type="varchar" name="customer_firstnamekana" nullable="true" length="255"
                comment="Customer Firstname Kana"/>
    </table>
    <table name="sales_order_address" resource="sales">
        <column xsi:type="varchar" name="lastnamekana" nullable="true" length="255"
                comment="Customer Lastname Kana"/>
        <column xsi:type="varchar" name="firstnamekana" nullable="true" length="255"
                comment="Customer Firstname Kana"/>
    </table>
    <table name="quote_address" resource="checkout">
        <column xsi:type="varchar" name="lastnamekana" nullable="true" length="255"
                comment="Customer Lastname Kana"/>
        <column xsi:type="varchar" name="firstnamekana" nullable="true" length="255"
                comment="Customer Firstname Kana"/>
    </table>
</schema>
